{
	"name": "Copilot review for default branch",
	"target": "branch",
	"enforcement": "active",
	"conditions": {
		"ref_name": {
			"exclude": [],
			"include": ["~DEFAULT_BRANCH", "refs/heads/development", "refs/heads/main"]
		}
	},
	"rules": [
		{
			"type": "deletion"
		},
		{
			"type": "non_fast_forward"
		},
		{
			"type": "copilot_code_review",
			"parameters": {
				"review_on_push": false,
				"review_draft_pull_requests": true
			}
		}
	],
	"bypass_actors": []
}
