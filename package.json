{
	"name": "spotq-payment-service",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:infisical": "infisical run --env=dev -- pnpm dev",
		"build": "tsc --noEmit && tsup",
		"test": "jest",
		"test:infisical": "infisical run --env=dev -- pnpm test",
		"start": "node dist/server.js",
		"lint": "biome check .",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"format": "biome check --write .",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:studio": "prisma studio",
		"seed:plans": "tsx prisma/seed.ts",
		"seed:failed-tx": "infisical run --env=dev -- tsx scripts/seed-failed-transaction.ts",
		"subscription:reset": "infisical run --env=dev -- tsx scripts/reset-subscription.ts",
		"invoice:test-pdf": "tsx scripts/test-invoice-pdf.ts",
		"invoice:publish": "tsx scripts/publish-test-invoice.ts",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.20.0",
			"onFail": "ignore"
		}
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1169.0",
		"@aws-sdk/s3-request-presigner": "^3.1169.0",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "7.10.1",
		"@spotq-org/circuit-breaker": "^1.0.0",
		"@spotq-org/rabbitmq-client": "^1.0.1",
		"@spotq-org/s2s-core": "^1.0.0",
		"axios": "^1.21.1",
		"bullmq": "^6.7.6",
		"dotenv": "^17.4.2",
		"express": "^5.3.0",
		"inversify": "^8.3.0",
		"ioredis": "^6.0.0",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"prom-client": "^15.1.3",
		"razorpay": "^2.9.8",
		"redis": "^6.3.1",
		"reflect-metadata": "^0.2.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@swc/core": "^1.16.22",
		"@swc/jest": "^0.2.39",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"lint-staged": "^17.6.1",
		"prisma": "7.10.1",
		"supertest": "^7.3.2",
		"tsc-alias": "^1.9.10",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"biome check --write"
		]
	}
}
