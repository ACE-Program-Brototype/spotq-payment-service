// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum PlanBillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

enum PaymentStatus {
  CREATED
  CAPTURED
  SUCCESS
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  PAID
  VOID
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum SettlementStatus {
  PENDING
  CALCULATING
  CREDITED_TO_WALLET
  FAILED
  ON_HOLD
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum WalletLedgerType {
  CREDIT_SETTLEMENT
  DEBIT_PAYOUT_WITHDRAWAL
  CREDIT_REFUND_ADJUSTMENT
}

enum PlatformTransactionType {
  CUSTOMER_PAYMENT_INTAKE
  SETTLEMENT_DISBURSED
  REFUND_EXPENSE
}

// ----------------------------------------------------
// Models
// ----------------------------------------------------

model SubscriptionPlan {
  id           String           @id @default(uuid()) @db.Uuid
  code         String           @unique
  name         String
  description  String?
  pricePaise   Int              @map("price_paise")
  currency     String           @default("INR")
  billingCycle PlanBillingCycle @default(MONTHLY) @map("billing_cycle")
  features     Json
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions       Subscription[]
  paymentTransactions PaymentTransaction[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  restaurantId       String             @map("restaurant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(PENDING)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  plan                SubscriptionPlan     @relation(fields: [planId], references: [id])
  paymentTransactions PaymentTransaction[]
  invoices            BillingInvoice[]

  @@index([restaurantId])
  @@index([status])
  @@map("subscriptions")
}

model PaymentTransaction {
  id             String  @id @default(uuid()) @db.Uuid
  restaurantId   String  @map("restaurant_id") @db.Uuid
  subscriptionId String? @map("subscription_id") @db.Uuid
  planId         String? @map("plan_id") @db.Uuid
  orderId        String? @map("order_id") @db.Uuid
  customerId     String? @map("customer_id") @db.Uuid

  razorpayOrderId   String  @unique @map("razorpay_order_id")
  razorpayPaymentId String? @unique @map("razorpay_payment_id")
  razorpaySignature String? @map("razorpay_signature")

  amountPaise   Int           @map("amount_paise")
  currency      String        @default("INR")
  status        PaymentStatus @default(CREATED)
  failureReason String?       @map("failure_reason")
  metadata      Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subscription Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  invoices     BillingInvoice[]
  refunds      PaymentRefund[]

  @@index([restaurantId])
  @@index([customerId])
  @@index([orderId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("payment_transactions")
}

model BillingInvoice {
  id                   String        @id @default(uuid()) @db.Uuid
  restaurantId         String        @map("restaurant_id") @db.Uuid
  subscriptionId       String?       @map("subscription_id") @db.Uuid
  paymentTransactionId String?       @map("payment_transaction_id") @db.Uuid
  invoiceNumber        String        @unique @map("invoice_number")
  amountPaise          Int           @map("amount_paise")
  currency             String        @default("INR")
  status               InvoiceStatus @default(DRAFT)
  invoicePdfKey        String?       @map("invoice_pdf_key")
  pdfGeneratedAt       DateTime?     @map("pdf_generated_at") @db.Timestamptz
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz

  subscription       Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([status])
  @@map("billing_invoices")
}

model PaymentRefund {
  id                   String @id @default(uuid()) @db.Uuid
  paymentTransactionId String @map("payment_transaction_id") @db.Uuid

  razorpayRefundId String       @unique @map("razorpay_refund_id")
  amountPaise      Int          @map("amount_paise")
  currency         String       @default("INR")
  status           RefundStatus @default(PROCESSED)
  reason           String?

  arn           String?
  paymentMethod String? @map("payment_method")
  destination   String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz

  transaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  @@index([paymentTransactionId])
  @@index([razorpayRefundId])
  @@map("payment_refunds")
}

model RestaurantWallet {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @unique @map("restaurant_id") @db.Uuid
  balancePaise BigInt  @default(0) @map("balance_paise")
  currency     String  @default("INR")
  isLocked     Boolean @default(false) @map("is_locked")

  // RazorpayX Tokenized Payout Vault (Zero raw account numbers or IFSC stored)
  razorpayFundAccountId String? @map("razorpay_fund_account_id")
  bankName              String? @map("bank_name")
  bankAccountLast4      String? @map("bank_account_last4")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  ledgerEntries WalletLedgerEntry[]

  @@map("restaurant_wallets")
}

model WalletLedgerEntry {
  id            String           @id @default(uuid()) @db.Uuid
  walletId      String           @map("wallet_id") @db.Uuid
  settlementId  String?          @map("settlement_id") @db.Uuid
  type          WalletLedgerType
  amountPaise   BigInt           @map("amount_paise")
  balanceBefore BigInt           @map("balance_before")
  balanceAfter  BigInt           @map("balance_after")
  referenceId   String?          @unique @map("reference_id") // Unique reference (Settlement ID, Razorpay Payout ID pout_..., or Reversal ID)
  utrNumber     String?          @map("utr_number") // Bank UTR reference from RazorpayX webhook
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz

  wallet     RestaurantWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  settlement Settlement?      @relation(fields: [settlementId], references: [id])

  @@index([walletId, createdAt(sort: Desc)])
  @@map("wallet_ledger_entries")
}

model Settlement {
  id                String           @id @default(uuid()) @db.Uuid
  settlementNumber  String           @unique @map("settlement_number")
  restaurantId      String           @map("restaurant_id") @db.Uuid
  settlementDate    DateTime         @map("settlement_date") @db.Date
  ordersCount       Int              @map("orders_count")
  grossSalesPaise   BigInt           @map("gross_sales_paise")
  totalRefundsPaise BigInt           @map("total_refunds_paise")
  netCreditPaise    BigInt           @map("net_credit_paise")
  status            SettlementStatus @default(PENDING)
  creditedAt        DateTime?        @map("credited_at") @db.Timestamptz
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  ledgerEntries WalletLedgerEntry[]

  @@unique([restaurantId, settlementDate]) // Natural idempotency: 1 settlement per date
  @@index([restaurantId, status])
  @@map("settlements")
}

model PlatformWallet {
  id                          String   @id @default(uuid()) @db.Uuid
  totalPlatformBalancePaise   BigInt   @default(0) @map("total_platform_balance_paise")
  totalDisbursedToVenuesPaise BigInt   @default(0) @map("total_disbursed_to_venues_paise")
  totalRefundedPaise          BigInt   @default(0) @map("total_refunded_paise")
  currency                    String   @unique @default("INR") @db.VarChar(10)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  transactions PlatformLedgerTransaction[]

  @@map("platform_wallets")
}

model PlatformLedgerTransaction {
  id                  String                  @id @default(uuid()) @db.Uuid
  platformWalletId    String                  @map("platform_wallet_id") @db.Uuid
  type                PlatformTransactionType
  amountPaise         BigInt                  @map("amount_paise")
  runningBalancePaise BigInt                  @map("running_balance_paise")
  referenceId         String?                 @unique @map("reference_id") @db.VarChar(100)
  restaurantId        String?                 @map("restaurant_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  platformWallet PlatformWallet @relation(fields: [platformWalletId], references: [id], onDelete: Restrict)

  @@index([type, createdAt])
  @@index([restaurantId])
  @@map("platform_ledger_transactions")
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  eventType   String       @map("event_type")
  aggregateId String       @map("aggregate_id")
  payload     Json
  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0) @map("retry_count")
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  publishedAt DateTime?    @map("published_at") @db.Timestamptz

  @@index([status, createdAt])
  @@map("outbox_events")
}

model WebhookLog {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("webhook_logs")
}
